    ],
    "steps": [
      {
        "id": "step-1",
        "kind": "prep",
        "text": "Whisk the cornmeal, flour, sugar, baking powder and salt in a large bowl."
      },
      {
        "id": "step-2",
        "kind": "prep",
        "text": "In another bowl, whisk the eggs and buttermilk, then whisk in 4 tablespoons of the melted butter."
      },
      {
        "id": "step-3",
        "kind": "prep",
        "text": "Beat the softened butter, honey and flaky salt until fluffy."
      },
      {
        "id": "step-4",
        "kind": "active",
        "text": "Put a 10-inch cast-iron skillet in the oven and heat the oven to 425F with the skillet inside, about 15 minutes."
      },
      {
        "id": "step-5",
        "kind": "active",
        "text": "Pour the wet ingredients into the dry and stir just until combined. Do not overmix; a few lumps are fine."
      },
      {
        "id": "step-6",
        "kind": "active",
        "text": "Carefully take the hot skillet out, add the remaining 2 tablespoons of butter and swirl to coat. Pour in the batter; it should sizzle."
      },
      {
        "id": "step-7",
        "kind": "active",
        "text": "Bake 20 to 25 minutes, until golden and a toothpick in the center comes out clean."
      },
      {
        "id": "step-8",
        "kind": "active",
        "text": "Cool the cornbread 10 minutes in the skillet, then cut into wedges and serve with the honey butter."
      }
    ],
