    "steps": [
      {
        "id": "step-1",
        "kind": "active",
        "text": "Toast the rolled oats in a dry saucepan over medium heat for 2 minutes, until fragrant."
      },
      {
        "id": "step-2",
        "kind": "active",
        "text": "Melt the butter in a small skillet until it foams and smells nutty."
      },
      {
        "id": "step-3",
        "kind": "active",
        "text": "Add the diced apple, brown sugar, and cinnamon; cook 5 minutes until soft."
      },
      {
        "id": "step-4",
        "kind": "active",
        "text": "Pour the milk over the oats, add the salt, and simmer 6 minutes, stirring often."
      },
      {
        "id": "step-5",
        "kind": "active",
        "text": "Spoon into bowls and top with the brown butter apples."
      }
