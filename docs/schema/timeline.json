{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TextSous timeline definition v1",
  "type": "object",
  "properties": {
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "component",
              "kitchen"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "color",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "prep",
              "cook",
              "finish"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cardTitle": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "subject",
              "context"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "completionCue": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          },
          "range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 180
                  },
                  "high": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 180
                  }
                },
                "required": [
                  "low",
                  "high"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "timingBasis": {
            "type": "string",
            "enum": [
              "source",
              "estimate"
            ]
          },
          "sourceQuote": {
            "type": [
              "string",
              "null"
            ]
          },
          "attention": {
            "type": "string",
            "enum": [
              "hands-on",
              "unattended"
            ]
          },
          "timerEnabledByDefault": {
            "type": "boolean"
          },
          "laneIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tip": {
            "type": [
              "string",
              "null"
            ]
          },
          "equipmentEvent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "oven-on",
                  "oven-off"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "scheduling": {
            "type": "object",
            "properties": {
              "waits": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "resourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ingredientIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "waits",
              "resourceIds",
              "ingredientIds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "phase",
          "label",
          "cardTitle",
          "description",
          "completionCue",
          "minutes",
          "range",
          "timingBasis",
          "sourceQuote",
          "attention",
          "timerEnabledByDefault",
          "laneIds",
          "dependencies",
          "sourceStepIds",
          "checkpoints",
          "tip",
          "equipmentEvent",
          "scheduling"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "resourceHolds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "resourceId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "resourceId"
        ],
        "additionalProperties": false
      }
    },
    "serveTaskId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "lanes",
    "tasks",
    "resources",
    "resourceHolds",
    "serveTaskId"
  ],
  "additionalProperties": false
}
