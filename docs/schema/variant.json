{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TextSous variant transform v1",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "dietary",
        "cuisine"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "titleOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "swaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromIngredientId": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "quantity",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "omitReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "packageRequirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "fromIngredientId",
          "reason",
          "packageRequirements"
        ],
        "additionalProperties": false
      }
    },
    "stepOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "stepId",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "taskOverrides": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completionCue": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checkpoints": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "taskId"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "techniqueChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "kind",
    "target",
    "swaps",
    "stepOverrides",
    "techniqueChanges",
    "rationale"
  ],
  "additionalProperties": false
}
